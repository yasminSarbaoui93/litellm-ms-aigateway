# Required Azure targets
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-existing-resource-group>
AI_GATEWAY_NAME=<your-existing-ai-gateway>
FOUNDRY_ACCOUNT_NAME=<your-existing-foundry-account>

# Optional overrides (defaults shown)
# FOUNDRY_RESOURCE_GROUP=<defaults to AZURE_RESOURCE_GROUP>
# FOUNDRY_MODEL_NAME=gpt-4o
# FOUNDRY_API_BASE=<defaults to https://<FOUNDRY_ACCOUNT_NAME>.openai.azure.com/>
# FOUNDRY_API_VERSION=2024-10-21
# AZURE_LOCATION=swedencentral
# POSTGRES_LOCATION=northeurope
# NAME_PREFIX=litellm-demo
# POSTGRES_SERVER_NAME=<defaults to psql-<NAME_PREFIX>>
# AI_GATEWAY_API_KEY=

# Auto-generated on first deployment (keep unchanged across redeploys)
LITELLM_MASTER_KEY=
UI_PASSWORD=
LITELLM_SALT_KEY=
